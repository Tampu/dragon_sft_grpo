{
  "name": "InternVL3_5-8B",
  "model_id": "OpenGVLab/InternVL3_5-8B",
  "revision": null,
  "model_class": "AutoModelForImageTextToText",
  "processor_class": "AutoProcessor",
  "trust_remote_code": false,
  "torch_dtype": "bfloat16",
  "attn_implementation": "flash_attention_2",

  "enable_thinking": false,
  "chat_template_kwargs": {},

  "image_processor_kwargs": {},
  "image_processor_attrs": {},

  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": "all-linear",
    "modules_to_save": null
  },

  "grpo_lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": "language-model-linear",
    "modules_to_save": null
  },

  "generation_defaults": {
    "max_new_tokens": 768,
    "do_sample": false,
    "num_beams": 1,
    "repetition_penalty": 1.0,
    "no_repeat_ngram_size": 6
  },

  "grpo_generation": {
    "max_new_tokens": 768,
    "temperature": 0.6,
    "top_p": 1.0,
    "no_repeat_ngram_size": 6
  },

  "_comment_tiling": "Consumed by dragon_vlm_interp/interp/tiling.py, NOT by the training pipeline -- InternVL's dynamic_preprocess defaults. If this checkpoint's own image_processor config uses different min/max tile counts or a different tile size, resolve_tile_layout()'s runtime assert will say so (token-count mismatch) -- update these to match rather than silencing the assert.",
  "tiling": {
    "scheme": "internvl_dynamic_tile",
    "min_tiles": 1,
    "max_tiles": 12,
    "tile_image_size": 448,
    "use_thumbnail": true
  }
}
